---
import { link } from "@/lib/url";
import {
  ArrowRight,
  BuildingComplex,
  Calculator,
  CircleCheck,
  Clock,
  Flame,
  Phone,
  Shield,
  Wrench,
} from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
import { getSiteSettings } from "@/lib/sanity";
import { getPage } from "@/lib/pages";

const { phones } = await getSiteSettings();
const { seo, hero, pillars: pillarsText, whyUs, cta } = await getPage("homePage");

const pillars = [
  {
    icon: BuildingComplex,
    ...pillarsText.management,
    href: "/uslugi/zarzadzanie-nieruchomosciami",
  },
  { icon: Flame, ...pillarsText.heating, href: "/uslugi/technika-grzewcza" },
];

const featureIcons = [Shield, Clock, Wrench, Calculator];
const features = whyUs.features.map((f, i) => ({
  ...f,
  icon: featureIcons[i % featureIcons.length],
}));
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <!-- HERO -->
  <section class="relative overflow-clip bg-gradient-hero">
    <div class="container-page grid lg:grid-cols-12 gap-12 items-center py-20 lg:py-28">
      <div class="lg:col-span-5">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-semibold text-primary uppercase tracking-wider">
          <Shield class="h-3.5 w-3.5" /> {hero.badge}
        </span>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-foreground leading-[1.05]">
          {hero.title} <span class="text-primary">{hero.titleHighlight}</span>
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl">{hero.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={link("/kontakt")}
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90 shadow-soft"
          >
            {hero.primaryButton} <ArrowRight class="h-4 w-4" />
          </a>
          <a
            href={link("/uslugi")}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold text-foreground hover:border-primary hover:text-primary"
          >
            {hero.secondaryButton}
          </a>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-6 max-w-md">
          {hero.stats.map((s) => (
            <div>
              <div class="text-3xl font-bold text-primary">{s.value}</div>
              <div class="text-xs text-muted-foreground mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="lg:col-span-7 relative">
        <div class="relative rounded-3xl overflow-clip shadow-soft aspect-[4/3] lg:aspect-[5/4] lg:h-[640px] lg:w-[115%] lg:-mr-[15%]">
          <Photo
            photo={hero.image}
            priority
            sizes="(min-width: 1024px) 60vw, 100vw"
            class="parallax absolute inset-0 w-full h-[120%] -top-[10%] object-cover"
          />
        </div>
        <div class="hidden md:block absolute -bottom-6 -left-6 bg-background rounded-2xl shadow-card p-5 border border-border max-w-xs z-10">
          <div class="flex items-center gap-3">
            <div class="rounded-full bg-primary-soft p-2.5">
              <Shield class="h-5 w-5 text-primary" />
            </div>
            <div>
              <div class="text-sm font-semibold">{hero.badgeCardTitle}</div>
              <div class="text-xs text-muted-foreground">{hero.badgeCardText}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TWO PILLARS -->
  <section class="container-page py-20">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-xs font-semibold text-primary uppercase tracking-wider">
        {pillarsText.eyebrow}
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold">{pillarsText.title}</h2>
      <p class="mt-4 text-muted-foreground">{pillarsText.intro}</p>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      {pillars.map((p) => (
        <article class="group rounded-3xl border border-border bg-card p-8 hover:shadow-soft hover:border-primary/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="rounded-2xl bg-primary-soft p-3">
              <p.icon class="h-7 w-7 text-primary" />
            </div>
            <h3 class="text-2xl font-bold">{p.title}</h3>
          </div>
          <p class="text-muted-foreground mb-5">{p.description}</p>
          <ul class="space-y-2 mb-6">
            {p.points.map((t) => (
              <li class="flex items-start gap-2 text-sm">
                <CircleCheck class="h-4 w-4 text-primary mt-0.5 shrink-0" /> {t}
              </li>
            ))}
          </ul>
          <a
            href={link(p.href)}
            class="inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 transition-all"
          >
            Dowiedz się więcej <ArrowRight class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- WHY US -->
  <section class="bg-secondary/50 py-20">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <Photo photo={whyUs.image} class="rounded-2xl shadow-soft w-full h-auto object-cover" />
        <div>
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">
            {whyUs.eyebrow}
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold">{whyUs.title}</h2>
          <p class="mt-4 text-muted-foreground">{whyUs.text}</p>
          <div class="mt-8 grid sm:grid-cols-2 gap-5">
            {features.map((f) => (
              <div class="flex gap-3">
                <div class="rounded-xl bg-primary-soft h-10 w-10 flex items-center justify-center shrink-0">
                  <f.icon class="h-5 w-5 text-primary" />
                </div>
                <div>
                  <div class="font-semibold text-sm">{f.title}</div>
                  <div class="text-xs text-muted-foreground mt-0.5">{f.description}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20">
    <div class="rounded-3xl bg-gradient-brand px-8 sm:px-14 py-14 text-center text-primary-foreground shadow-soft">
      <h2 class="text-3xl sm:text-4xl font-bold">{cta.title}</h2>
      <p class="mt-4 text-primary-foreground/85 max-w-2xl mx-auto">{cta.text}</p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a
          href={phones.office.href}
          class="inline-flex items-center gap-2 rounded-full bg-background px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
        >
          <Phone class="h-4 w-4" />
          {phones.office.label}
        </a>
        <a
          href={phones.management.href}
          class="inline-flex items-center gap-2 rounded-full bg-background px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
        >
          <Phone class="h-4 w-4" />
          {phones.management.label}
        </a>
        <a
          href={link("/kontakt")}
          class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/40 px-6 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary-foreground/10"
        >
          Formularz kontaktowy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
