---
import {
  ArrowRight,
  BuildingComplex,
  Calculator,
  CircleCheck,
  Clock,
  Flame,
  Phone,
  Shield,
  Wrench,
} from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Img from "@/components/Img.astro";
import { PHONES } from "@/data/site";
import hero from "@/assets/hero-buildings.jpg";
import boiler from "@/assets/heating-boiler.jpg";

const TITLE = "Dalkowski Piaseczno — Zarządzanie Nieruchomościami i Serwis Kotłów Gazowych";
const DESC =
  "Profesjonalne zarządzanie wspólnotami mieszkaniowymi oraz serwis i instalacja kotłów gazowych w Piasecznie, Warszawie, Konstancinie-Jeziornej i Józefosławiu. Doświadczenie od 2006 roku.";

const pillars = [
  {
    icon: BuildingComplex,
    title: "Zarządzanie nieruchomościami",
    desc: "Pełna obsługa administracyjna, księgowa i techniczna wspólnot mieszkaniowych. Administrator dostępny pod telefonem całą dobę.",
    items: [
      "Obsługa administracyjna i prawna",
      "Księgowość wspólnoty i rozliczenia mediów",
      "Nadzór techniczny i konserwacje",
      "Reprezentacja wspólnoty przed urzędami",
    ],
    href: "/uslugi/zarzadzanie-nieruchomosciami",
  },
  {
    icon: Flame,
    title: "Technika grzewcza",
    desc: "Autoryzowany serwis kotłów gazowych De Dietrich — przeglądy, naprawy i instalacje kotłów gazowych. Umawiamy wizyty na dogodne godziny.",
    items: [
      "Naprawy awaryjne — szybki dojazd",
      "Coroczne przeglądy i konserwacje",
      "Sprzedaż i montaż nowych kotłów gazowych",
      "Gwarancja na piśmie na każdą usługę",
    ],
    href: "/uslugi/technika-grzewcza",
  },
];

const features = [
  { icon: Shield, t: "Pełna polisa OC", d: "Ubezpieczenie zawodowe 50 000 €" },
  { icon: Clock, t: "Reakcja 24/7", d: "Awaria? Dzwonisz — przyjeżdżamy." },
  { icon: Wrench, t: "Własny dział techniczny", d: "Bez podwykonawców z drugiej ręki." },
  {
    icon: Calculator,
    t: "Przejrzysta księgowość",
    d: "Roczne sprawozdania i pełna dokumentacja.",
  },
];
---

<BaseLayout
  title={TITLE}
  description={DESC}
  keywords="zarządzanie nieruchomościami Piaseczno, administrowanie wspólnot, serwis kotłów gazowych co Piaseczno, instalacja kotłów De Dietrich, Dalkowski"
>
  <!-- HERO -->
  <section class="relative overflow-clip bg-gradient-hero">
    <div class="container-page grid lg:grid-cols-12 gap-12 items-center py-20 lg:py-28">
      <div class="lg:col-span-5">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary-soft px-4 py-1.5 text-xs font-semibold text-primary uppercase tracking-wider">
          <Shield class="h-3.5 w-3.5" /> Doświadczenie od 2006 roku
        </span>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-foreground leading-[1.05]">
          Twoja nieruchomość <br />w <span class="text-primary">dobrych rękach</span>
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl">
          Kompleksowe zarządzanie wspólnotami mieszkaniowymi i profesjonalny serwis kotłów gazowych
          centralnego ogrzewania w Piasecznie, Warszawie i okolicach.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/kontakt"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90 shadow-soft"
          >
            Skontaktuj się z nami <ArrowRight class="h-4 w-4" />
          </a>
          <a
            href="/uslugi"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold text-foreground hover:border-primary hover:text-primary"
          >
            Nasze usługi
          </a>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-6 max-w-md">
          <div>
            <div class="text-3xl font-bold text-primary">18+</div>
            <div class="text-xs text-muted-foreground mt-1">lat doświadczenia</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">15</div>
            <div class="text-xs text-muted-foreground mt-1">obsługiwanych wspólnot</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">24/7</div>
            <div class="text-xs text-muted-foreground mt-1">awarie w zarządzanych wspólnotach</div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 relative">
        <div class="relative rounded-3xl overflow-clip shadow-soft aspect-[4/3] lg:aspect-[5/4] lg:h-[640px] lg:w-[115%] lg:-mr-[15%]">
          <Img
            src={hero}
            alt="Nowoczesne budynki mieszkalne zarządzane przez Dalkowski w Piasecznie"
            priority
            sizes="(min-width: 1024px) 60vw, 100vw"
            class="parallax absolute inset-0 w-full h-[120%] -top-[10%] object-cover"
          />
        </div>
        <div class="hidden md:block absolute -bottom-6 -left-6 bg-background rounded-2xl shadow-card p-5 border border-border max-w-xs z-10">
          <div class="flex items-center gap-3">
            <div class="rounded-full bg-primary-soft p-2.5">
              <Shield class="h-5 w-5 text-primary" />
            </div>
            <div>
              <div class="text-sm font-semibold">Polisa OC 50 000 €</div>
              <div class="text-xs text-muted-foreground">Licencja zawodowa nr 23367</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TWO PILLARS -->
  <section class="container-page py-20">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-xs font-semibold text-primary uppercase tracking-wider">
        Dwa filary, jedna firma
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Co dla Ciebie zrobimy</h2>
      <p class="mt-4 text-muted-foreground">
        Od administracji budynkiem po szybki serwis kotła gazowego — wszystko w jednym miejscu.
      </p>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      {pillars.map((p) => (
        <article class="group rounded-3xl border border-border bg-card p-8 hover:shadow-soft hover:border-primary/30 transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class="rounded-2xl bg-primary-soft p-3">
              <p.icon class="h-7 w-7 text-primary" />
            </div>
            <h3 class="text-2xl font-bold">{p.title}</h3>
          </div>
          <p class="text-muted-foreground mb-5">{p.desc}</p>
          <ul class="space-y-2 mb-6">
            {p.items.map((t) => (
              <li class="flex items-start gap-2 text-sm">
                <CircleCheck class="h-4 w-4 text-primary mt-0.5 shrink-0" /> {t}
              </li>
            ))}
          </ul>
          <a
            href={p.href}
            class="inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 transition-all"
          >
            Dowiedz się więcej <ArrowRight class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- WHY US -->
  <section class="bg-secondary/50 py-20">
    <div class="container-page">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <Img
          src={boiler}
          alt="Profesjonalny serwis kotła gazowego — Dalkowski Technika Grzewcza"
          class="rounded-2xl shadow-soft w-full h-auto object-cover"
        />
        <div>
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">
            Dlaczego my
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Lokalna firma rodzinna z misją</h2>
          <p class="mt-4 text-muted-foreground">
            Działamy w Piasecznie, Warszawie i okolicach od 2006 roku. Łączymy zarządzanie
            wspólnotami z własnym działem technicznym — dzięki temu nasze osiedla otrzymują szybką,
            fachową obsługę awarii i przeglądów.
          </p>
          <div class="mt-8 grid sm:grid-cols-2 gap-5">
            {features.map((f) => (
              <div class="flex gap-3">
                <div class="rounded-xl bg-primary-soft h-10 w-10 flex items-center justify-center shrink-0">
                  <f.icon class="h-5 w-5 text-primary" />
                </div>
                <div>
                  <div class="font-semibold text-sm">{f.t}</div>
                  <div class="text-xs text-muted-foreground mt-0.5">{f.d}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20">
    <div class="rounded-3xl bg-gradient-brand px-8 sm:px-14 py-14 text-center text-primary-foreground shadow-soft">
      <h2 class="text-3xl sm:text-4xl font-bold">
        Potrzebujesz pomocy z nieruchomością lub kotłem?
      </h2>
      <p class="mt-4 text-primary-foreground/85 max-w-2xl mx-auto">
        Zadzwoń lub napisz — odpowiemy w ciągu dnia roboczego. Awarie w zarządzanych przez nas
        wspólnotach obsługujemy całą dobę.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a
          href={PHONES.office.href}
          class="inline-flex items-center gap-2 rounded-full bg-background px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
        >
          <Phone class="h-4 w-4" />
          {PHONES.office.label}
        </a>
        <a
          href={PHONES.management.href}
          class="inline-flex items-center gap-2 rounded-full bg-background px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
        >
          <Phone class="h-4 w-4" />
          {PHONES.management.label}
        </a>
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/40 px-6 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary-foreground/10"
        >
          Formularz kontaktowy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
