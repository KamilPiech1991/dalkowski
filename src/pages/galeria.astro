---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Photo from "@/components/Photo.astro";
import { getGallery } from "@/lib/sanity";
import { getPage } from "@/lib/pages";
import hero from "@/assets/hero-buildings.jpg";

const page = await getPage("galleryPage");

const groups = [
  { title: page.workTitle, photos: await getGallery("praca") },
  { title: page.referencesTitle, photos: await getGallery("realizacje") },
].filter((g) => g.photos.length > 0);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  ogImage={hero.src}
>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title}>
    {page.hero.lead}
  </PageHero>

  <section class="container-page py-16">
    {groups.map((g, gi) => (
      <>
        <h2 class:list={["text-2xl sm:text-3xl font-bold mb-8", gi > 0 && "mt-16"]}>{g.title}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {g.photos.map((it) => (
            <figure class="group overflow-hidden rounded-2xl border border-border bg-card shadow-card">
              <Photo
                photo={it}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-72 object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <figcaption class="p-4 text-xs text-muted-foreground">{it.alt}</figcaption>
            </figure>
          ))}
        </div>
      </>
    ))}
  </section>
</BaseLayout>
