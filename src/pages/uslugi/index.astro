---
import { ArrowRight, BuildingComplex, Flame, Wrench } from "@lucide/astro";
import { link } from "@/lib/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { getPage } from "@/lib/pages";

const page = await getPage("servicesPage");

const services = [
  {
    href: "/uslugi/zarzadzanie-nieruchomosciami",
    icon: BuildingComplex,
    ...page.management,
  },
  {
    href: "/uslugi/konserwacja-nieruchomosci",
    icon: Wrench,
    ...page.maintenance,
  },
  {
    href: "/uslugi/technika-grzewcza",
    icon: Flame,
    ...page.heating,
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} keywords={page.seo.keywords}>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title}>
    {page.hero.lead}
  </PageHero>

  <section class="container-page py-16 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((s) => (
      <a
        href={link(s.href)}
        class="group rounded-3xl border border-border bg-card p-10 hover:shadow-soft hover:border-primary/30 transition-all"
      >
        <div class="rounded-2xl bg-primary-soft p-4 w-fit">
          <s.icon class="h-8 w-8 text-primary" />
        </div>
        <h2 class="mt-5 text-2xl font-bold">{s.title}</h2>
        <p class="mt-3 text-muted-foreground">{s.description}</p>
        <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 transition-all">
          Przejdź do oferty <ArrowRight class="h-4 w-4" />
        </span>
      </a>
    ))}
  </section>
</BaseLayout>
