---
import { link } from "@/lib/url";
import { Calculator, CircleCheck, ClipboardList, Phone, Wrench } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Photo from "@/components/Photo.astro";
import { getSiteSettings } from "@/lib/sanity";
import { getPage } from "@/lib/pages";

const { phones } = await getSiteSettings();
const page = await getPage("managementPage");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Zarządzanie nieruchomościami",
  provider: { "@type": "LocalBusiness", name: "Dalkowski", telephone: "+48793720760" },
  areaServed: ["Piaseczno", "Warszawa", "Konstancin-Jeziorna", "Józefosław"],
  description: page.seo.description,
};

const sectionIcons = [ClipboardList, Calculator, Wrench];
const sections = page.sections.map((s, i) => ({
  ...s,
  icon: sectionIcons[i % sectionIcons.length],
}));
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  ogType="article"
  jsonLd={[jsonLd]}
>
  <section class="bg-gradient-hero" data-hero>
    <div class="container-page py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <Breadcrumb current="Zarządzanie nieruchomościami" />
        <h1 class="text-4xl sm:text-5xl font-extrabold max-w-3xl">{page.hero.title}</h1>
        <div
          class="rich-text mt-5 max-w-3xl text-muted-foreground [&>p:first-child]:text-lg"
          data-reveal
          set:html={page.hero.lead}
        />
      </div>
      <div class="lg:col-span-5" data-hero-image>
        <Photo
          photo={page.hero.image}
          priority
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="rounded-3xl shadow-soft w-full h-80 lg:h-[420px] object-cover"
        />
      </div>
    </div>
  </section>

  <!-- GALLERY STRIP — referencyjne obiekty -->
  <section class="container-page pt-16">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="text-xs font-semibold text-primary uppercase tracking-wider" data-reveal>
        {page.references.eyebrow}
      </span>
      <h2 class="mt-3 text-3xl font-bold">{page.references.title}</h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-reveal-group>
      {page.references.images.map((it) => (
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-card group">
          <Photo
            photo={it}
            sizes="(min-width: 1024px) 25vw, 50vw"
            class="w-full h-44 sm:h-56 object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-16 grid gap-8" data-reveal-group>
    {sections.map((s, idx) => (
      <article class="rounded-3xl border border-border bg-card overflow-hidden">
        <div class="grid lg:grid-cols-12">
          <div class:list={["lg:col-span-4", idx % 2 === 1 && "lg:order-2"]} data-reveal-image>
            <Photo
              photo={s.image}
              sizes="(min-width: 1024px) 33vw, 100vw"
              class="w-full h-56 lg:h-full object-cover"
            />
          </div>
          <div class="lg:col-span-8 p-8 sm:p-10">
            <div class="flex items-center gap-4 mb-6">
              <div class="rounded-2xl bg-primary-soft p-3">
                <s.icon class="h-7 w-7 text-primary" />
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold">{s.title}</h2>
            </div>
            <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3" data-reveal-group>
              {s.points.map((i) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <CircleCheck class="h-4 w-4 text-primary mt-0.5 shrink-0" /> {i}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- CTA -->
  <section class="container-page pb-20">
    <div class="grid lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-5 rounded-3xl overflow-hidden shadow-card" data-reveal-image>
        <Photo photo={page.cta.image} class="w-full h-72 lg:h-full object-cover" />
      </div>
      <div
        class="lg:col-span-7 rounded-3xl bg-gradient-brand p-10 sm:p-14 text-primary-foreground shadow-soft flex flex-col justify-center"
        data-reveal
      >
        <h2 class="text-2xl sm:text-3xl font-bold">{page.cta.title}</h2>
        <p class="mt-3 text-primary-foreground/85">{page.cta.text}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={phones.management.href}
            class="inline-flex items-center gap-2 rounded-full bg-background text-primary px-6 py-3 text-sm font-semibold"
          >
            <Phone class="h-4 w-4" /> {phones.management.label}
          </a>
          <a
            href={phones.office.href}
            class="inline-flex items-center gap-2 rounded-full bg-background text-primary px-6 py-3 text-sm font-semibold"
          >
            <Phone class="h-4 w-4" /> {phones.office.label}
          </a>
          <a
            href={link("/kontakt")}
            class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/40 px-6 py-3 text-sm font-semibold hover:bg-primary-foreground/10"
          >
            Napisz do nas
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
