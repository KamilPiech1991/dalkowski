---
import { link } from "@/lib/url";
import {
  CircleCheck,
  Clock,
  Droplets,
  Hammer,
  Phone,
  ShieldCheck,
  Wrench,
  Zap,
} from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
import { getSiteSettings } from "@/lib/sanity";
import { getPage } from "@/lib/pages";

const { phones } = await getSiteSettings();
const page = await getPage("maintenancePage");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Konserwacja nieruchomości",
  provider: { "@type": "LocalBusiness", name: "Dalkowski", telephone: "+48730704502" },
  areaServed: ["Piaseczno", "Konstancin-Jeziorna", "Józefosław", "Warszawa"],
  description: page.seo.description,
  hoursAvailable: "Mo,Tu,We,Th,Fr,Sa,Su 00:00-23:59",
};

const sectionIcons = [Droplets, Zap, Hammer];
const sections = page.sections.map((s, i) => ({
  ...s,
  icon: sectionIcons[i % sectionIcons.length],
}));

const badgeIcons = [Clock, ShieldCheck, Wrench];
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  ogType="article"
  jsonLd={[jsonLd]}
>
  <section class="bg-gradient-hero">
    <div class="container-page py-16 lg:py-24 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
      <div>
        <span class="text-xs font-semibold text-primary uppercase tracking-wider">
          {page.hero.eyebrow}
        </span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold leading-tight">{page.hero.title}</h1>
        <div class="rich-text mt-5 text-lg text-muted-foreground" set:html={page.hero.lead} />
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={phones.technical.href}
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
          >
            <Phone class="h-4 w-4" /> Zgłoś awarię: {phones.technical.label}
          </a>
          <a
            href={phones.office.href}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold hover:border-primary transition-colors"
          >
            <Phone class="h-4 w-4 text-primary" /> Biuro: {phones.office.label}
          </a>
          <a
            href={link("/kontakt")}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold hover:border-primary transition-colors"
          >
            Zapytaj o ofertę
          </a>
        </div>
        <div class="mt-8 flex flex-wrap gap-6 text-sm text-muted-foreground">
          {page.hero.badges.map((badge, i) => {
            const Icon = badgeIcons[i % badgeIcons.length];
            return (
              <span class="inline-flex items-center gap-2">
                <Icon class="h-4 w-4 text-primary" /> {badge}
              </span>
            );
          })}
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden shadow-soft">
        <Photo photo={page.hero.image} priority class="w-full h-auto" />
      </div>
    </div>
  </section>

  <section class="container-page py-16 lg:py-20">
    <div class="max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-extrabold">{page.intro.title}</h2>
      <p class="mt-4 text-muted-foreground">{page.intro.text}</p>
    </div>
  </section>

  {sections.map((s, i) => (
    <section class:list={[i % 2 === 0 && "bg-secondary/40"]}>
      <div class="container-page py-16 lg:py-20 grid lg:grid-cols-2 gap-10 items-center">
        <div class:list={[i % 2 === 1 && "lg:order-2"]}>
          <div class="rounded-2xl bg-primary-soft p-4 w-fit">
            <s.icon class="h-8 w-8 text-primary" />
          </div>
          <h2 class="mt-5 text-3xl font-extrabold">{s.title}</h2>
          <p class="mt-3 text-muted-foreground">{s.intro}</p>
          <ul class="mt-6 space-y-3">
            {s.points.map((it) => (
              <li class="flex items-start gap-3">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 mt-0.5" />
                <span class="text-foreground/90">{it}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class:list={["rounded-3xl overflow-hidden shadow-soft", i % 2 === 1 && "lg:order-1"]}>
          <Photo photo={s.image} class="w-full h-auto" />
        </div>
      </div>
    </section>
  ))}

  <section class="container-page py-16 lg:py-20">
    <div class="rounded-3xl bg-primary text-primary-foreground p-10 lg:p-14 grid lg:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold">{page.cta.title}</h2>
        <p class="mt-4 opacity-90">{page.cta.text}</p>
      </div>
      <div class="flex flex-col gap-3">
        <a
          href={phones.technical.href}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-background text-foreground px-6 py-3 text-sm font-semibold hover:opacity-90"
        >
          <Phone class="h-4 w-4" />
          {phones.technical.label}
        </a>
        <a
          href={link("/uslugi/zarzadzanie-nieruchomosciami")}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-primary-foreground/40 px-6 py-3 text-sm font-semibold hover:bg-primary-foreground/10"
        >
          Zobacz pakiet zarządzania
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
