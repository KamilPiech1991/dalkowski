---
import {
  CircleAlert,
  Calendar,
  CircleCheck,
  Phone,
  ShieldCheck,
  ShoppingCart,
} from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Photo from "@/components/Photo.astro";
import { getPricing, getSiteSettings } from "@/lib/sanity";
import { getPage } from "@/lib/pages";
import boiler from "@/assets/heating-boiler.jpg";

const { phones } = await getSiteSettings();
const page = await getPage("heatingPage");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Autoryzowany serwis kotłów gazowych De Dietrich",
  provider: {
    "@type": "LocalBusiness",
    name: "Dalkowski Technika Grzewcza",
    telephone: "+48730704502",
  },
  areaServed: ["Piaseczno", "Konstancin-Jeziorna", "Józefosław", "Warszawa"],
  description: page.seo.description,
  offers: [
    {
      "@type": "Offer",
      name: "Przegląd okresowy kotła gazowego De Dietrich",
      price: "350",
      priceCurrency: "PLN",
      description: "Cena netto",
    },
    {
      "@type": "Offer",
      name: "Naprawa awaryjna kotła gazowego",
      priceCurrency: "PLN",
      description: "Wycena indywidualna — zakres i koszt zależą od usterki",
    },
    {
      "@type": "Offer",
      name: "Montaż kotła gazowego",
      priceCurrency: "PLN",
      description: "Wycena indywidualna",
    },
  ],
};

const serviceIcons = [CircleAlert, Calendar, ShoppingCart];
const services = page.services.map((s, i) => ({
  ...s,
  icon: serviceIcons[i % serviceIcons.length],
}));

const cennik = await getPricing();
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  ogType="article"
  ogImage={boiler.src}
  jsonLd={[jsonLd]}
>
  <section class="bg-gradient-hero" data-hero>
    <div class="container-page py-16 lg:py-24 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <Breadcrumb current="Technika grzewcza" />
        <h1 class="text-4xl sm:text-5xl font-extrabold">{page.hero.title}</h1>
        <div
          class="rich-text mt-5 text-lg text-muted-foreground"
          data-reveal
          set:html={page.hero.lead}
        />
        <div class="mt-7 flex flex-wrap gap-3" data-reveal>
          <a
            href={phones.technical.href}
            class="inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-6 py-3 text-sm font-semibold shadow-soft"
          >
            <Phone class="h-4 w-4" /> Serwis: {phones.technical.label}
          </a>
          <a
            href={phones.office.href}
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold hover:border-primary transition-colors"
          >
            <Phone class="h-4 w-4 text-primary" /> Biuro: {phones.office.label}
          </a>
        </div>
      </div>
      <div data-hero-image>
        <Photo
          photo={page.hero.image}
          priority
          class="rounded-2xl shadow-soft w-full h-auto object-cover"
        />
      </div>
    </div>
  </section>

  <section class="container-page py-16 grid md:grid-cols-3 gap-6" data-reveal-group>
    {services.map((s) => (
      <article class="rounded-3xl border border-border bg-card overflow-hidden flex flex-col">
        <Photo
          photo={s.image}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="w-full h-48 object-cover"
        />
        <div class="p-7">
          <div class="rounded-2xl bg-primary-soft p-3 w-fit">
            <s.icon class="h-6 w-6 text-primary" />
          </div>
          <h2 class="mt-5 text-xl font-bold">{s.title}</h2>
          <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{s.description}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-secondary/50 py-16">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-semibold text-primary uppercase tracking-wider" data-reveal>
          {page.authorization.eyebrow}
        </span>
        <h2 class="mt-3 text-3xl font-bold">{page.authorization.title}</h2>
        <p class="mt-3 text-muted-foreground" data-reveal>
          {page.authorization.text}
        </p>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal-group>
        {page.authorization.brands.map((m) => (
          <span class="rounded-full bg-background border border-border px-5 py-2.5 text-sm font-semibold text-foreground/80">
            {m}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16 grid lg:grid-cols-2 gap-10">
    <div>
      <div class="rounded-3xl overflow-hidden shadow-card mb-8" data-reveal-image>
        <Photo photo={page.quality.image} class="w-full h-72 object-cover" />
      </div>
      <span class="text-xs font-semibold text-primary uppercase tracking-wider" data-reveal>
        {page.quality.eyebrow}
      </span>
      <h2 class="mt-3 text-3xl font-bold flex items-center gap-2">
        <ShieldCheck class="h-7 w-7 text-primary" /> {page.quality.title}
      </h2>
      <ul class="mt-6 space-y-3" data-reveal-group>
        {page.quality.points.map((g) => (
          <li class="flex items-start gap-2 text-sm">
            <CircleCheck class="h-4 w-4 text-primary mt-0.5 shrink-0" /> {g}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-3xl border border-border bg-card p-8 h-fit" data-reveal>
      <h2 class="text-2xl font-bold">{page.pricingTitle}</h2>
      <div class="mt-6 space-y-5" data-reveal-group>
        {cennik.map((c, i) => (
          <div class:list={[i < cennik.length - 1 && "border-b border-border pb-4"]}>
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-semibold">{c.name}</h3>
              <span class="text-primary font-bold whitespace-nowrap">{c.price}</span>
            </div>
            <p class="text-xs text-muted-foreground mt-2">{c.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
