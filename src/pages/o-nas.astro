---
import { Award, CircleCheck, MapPin } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Photo from "@/components/Photo.astro";
import { getCommunities } from "@/lib/sanity";
import { getPage } from "@/lib/pages";

const page = await getPage("aboutPage");
const wspolnoty = await getCommunities();
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  ogType="article"
>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title}>
    {page.hero.lead}
  </PageHero>

  <section class="container-page py-16">
    <div class="grid lg:grid-cols-[400px_1fr] gap-12">
      <div>
        <div class="rounded-2xl overflow-hidden shadow-soft" data-reveal-image>
          <Photo
            photo={page.portrait}
            sizes="(min-width: 1024px) 400px, 100vw"
            class="w-full h-auto object-cover"
          />
        </div>
        <div class="mt-6 rounded-2xl border border-border p-5 bg-card" data-reveal>
          <div class="flex items-center gap-2 text-sm font-semibold">
            <Award class="h-4 w-4 text-primary" /> {page.licenseBox.title}
          </div>
          <p class="text-xs text-muted-foreground mt-2">{page.licenseBox.text}</p>
        </div>
      </div>

      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">{page.owner.title}</h2>
        <div
          class="rich-text mt-4 text-muted-foreground leading-relaxed"
          data-reveal
          set:html={page.owner.body}
        />

        <h3 class="mt-10 text-xl font-bold flex items-center gap-2" data-reveal>
          <MapPin class="h-5 w-5 text-primary" /> {page.communitiesTitle}
        </h3>
        <ul class="mt-4 grid sm:grid-cols-2 gap-2" data-reveal-group>
          {wspolnoty.map((w) => (
            <li class="flex items-start gap-2 text-sm text-muted-foreground">
              <CircleCheck class="h-4 w-4 text-primary mt-0.5 shrink-0" /> {w}
            </li>
          ))}
        </ul>

        <h3 class="mt-10 text-xl font-bold" data-reveal>
          {page.heating.title}
        </h3>
        <div
          class="rich-text mt-3 text-muted-foreground leading-relaxed"
          data-reveal
          set:html={page.heating.body}
        />
      </div>
    </div>
  </section>
</BaseLayout>
