---
import { TriangleAlert, Clock, MapPin, Phone } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { getSiteSettings } from "@/lib/sanity";

const { phones, emails, address, openingHours } = await getSiteSettings();

const TITLE = "Kontakt — Dalkowski Piaseczno | Zarządzanie i Serwis Kotłów Gazowych";
const DESC = `Skontaktuj się z firmą Dalkowski w Piasecznie i Warszawie. Tel. ${phones.office.label} (biuro), ${phones.management.label} (zarządzanie nieruchomościami), ${phones.technical.label} (technika grzewcza, hydraulika, elektryka). ${address.street}, ${address.postalCode} ${address.city}.`;

const contacts = [
  {
    icon: Phone,
    title: "Biuro — umawianie wizyt i zgłoszenia",
    note: "Główny numer kontaktowy do wszystkich usług — zarządzanie, konserwacja i technika grzewcza.",
    phone: phones.office,
    officeFallback: false,
    email: emails.office,
  },
  {
    icon: Phone,
    title: "Zarządzanie nieruchomościami",
    note: "Barbara Dalkowska — zarządca nieruchomości. Gdy numer jest zajęty, prosimy dzwonić do biura.",
    phone: phones.management,
    officeFallback: true,
    email: emails.management,
  },
  {
    icon: TriangleAlert,
    title: "Kotły gazowe, hydraulika, elektryka",
    note: "Pan Roman — serwis kotłów gazowych De Dietrich, usługi hydrauliczne, elektryczne i złota rączka. Całodobowa reakcja dotyczy wspólnot, dla których pełnimy funkcję administratora i/lub konserwatora; z klientami indywidualnymi umawiamy się na dogodne godziny.",
    phone: phones.technical,
    officeFallback: true,
    email: emails.technical,
  },
];

const fieldClass =
  "mt-1 w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40";
---

<BaseLayout title={TITLE} description={DESC}>
  <PageHero eyebrow="Kontakt" title="Porozmawiajmy" wide={false}>
    Jeśli potrzebują Państwo dodatkowych wyjaśnień, służymy pomocą. Proszę dzwonić lub pisać na
    adres e-mail.
  </PageHero>

  <section class="container-page py-16 grid lg:grid-cols-2 gap-10">
    <div class="space-y-5">
      {contacts.map((c) => (
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-lg font-bold flex items-center gap-2">
            <c.icon class="h-5 w-5 text-primary" /> {c.title}
          </h2>
          <p class="text-xs text-muted-foreground mt-2">{c.note}</p>
          <div class="mt-3 space-y-1 text-sm">
            <a href={c.phone.href} class="block font-semibold text-foreground hover:text-primary">
              {c.phone.label}
            </a>
            {c.officeFallback && (
              <a href={phones.office.href} class="block text-muted-foreground hover:text-primary">
                {phones.office.label} (biuro)
              </a>
            )}
            <a href={`mailto:${c.email}`} class="block text-muted-foreground hover:text-primary">
              {c.email}
            </a>
          </div>
        </div>
      ))}

      <div class="rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <MapPin class="h-5 w-5 text-primary" /> Adres
        </h2>
        <address class="not-italic mt-3 text-sm text-muted-foreground">
          {address.street}
          <br />
          {`${address.postalCode} ${address.city}`}
          <br />
          Polska
        </address>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <Clock class="h-5 w-5 text-primary" /> Godziny pracy
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">
          <strong class="text-foreground">{openingHours}</strong>
        </p>
        <p class="text-sm text-muted-foreground">
          Serwis kotłów gazowych:{" "}
          <strong class="text-foreground">wizyty w uzgodnionych godzinach</strong>
        </p>
      </div>
    </div>

    <!-- Formularz bez JS: przeglądarka otwiera program pocztowy z wypełnioną wiadomością -->
    <form
      class="rounded-2xl border border-border bg-card p-7 h-fit"
      action={`mailto:${emails.office}?subject=${encodeURIComponent("Wiadomość ze strony dalkowski")}`}
      method="post"
      enctype="text/plain"
    >
      <h2 class="text-2xl font-bold">Napisz do nas</h2>
      <p class="text-sm text-muted-foreground mt-1">Odpowiemy w ciągu dnia roboczego.</p>
      <div class="mt-5 space-y-4">
        <div>
          <label class="text-xs font-semibold text-foreground" for="topic">
            Temat kontaktu <span class="text-primary">*</span>
          </label>
          <select id="topic" name="Temat" required class={fieldClass}>
            <option value="" disabled selected>
              Wybierz temat…
            </option>
            <option value="Kotły gazowe">Kotły gazowe</option>
            <option value="Administracja">Administracja</option>
            <option value="Konserwacja techniczna">Konserwacja techniczna</option>
          </select>
          <p class="mt-1 text-xs text-muted-foreground">
            Dzięki temu wiadomość trafi od razu do właściwej osoby.
          </p>
        </div>
        <div>
          <label class="text-xs font-semibold text-foreground" for="name">
            Imię i nazwisko
          </label>
          <input
            id="name"
            name="Imię i nazwisko"
            required
            maxlength="100"
            autocomplete="name"
            class={fieldClass}
          />
        </div>
        <div>
          <label class="text-xs font-semibold text-foreground" for="email">
            E-mail
          </label>
          <input
            id="email"
            name="E-mail"
            type="email"
            required
            maxlength="255"
            autocomplete="email"
            class={fieldClass}
          />
        </div>
        <div>
          <label class="text-xs font-semibold text-foreground" for="message">
            Treść wiadomości
          </label>
          <textarea
            id="message"
            name="Wiadomość"
            rows="6"
            required
            maxlength="2000"
            class={fieldClass}
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-full bg-primary text-primary-foreground py-3 text-sm font-semibold hover:opacity-90"
        >
          Wyślij wiadomość
        </button>
      </div>
    </form>
  </section>
</BaseLayout>
