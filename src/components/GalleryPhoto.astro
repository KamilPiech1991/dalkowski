---
import Img from "@/components/Img.astro";
import type { GalleryPhoto } from "@/lib/sanity";

interface Props {
  photo: GalleryPhoto;
  class?: string;
  sizes?: string;
}

const { photo, class: className, sizes } = Astro.props;
---

{photo.kind === "local" ? (
  <Img src={photo.src} alt={photo.alt} class={className} sizes={sizes} />
) : (
  <img
    src={photo.src}
    srcset={photo.srcset}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={photo.alt}
    class={className}
    loading="lazy"
    decoding="async"
  />
)}
