---
import { Picture } from "astro:assets";
import type { ImageSource } from "@/lib/images";

interface Props {
  src: ImageSource;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  priority?: boolean;
  sizes?: string;
  style?: string;
  [key: `data-${string}`]: string | undefined;
}

const { src, alt, class: className, width, height, priority, sizes, ...rest } = Astro.props;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
---

{typeof src === "string" ? (
  <img
    src={src}
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    {...rest}
  />
) : (
  <Picture
    src={src}
    alt={alt}
    class={className}
    formats={["avif", "webp"]}
    quality={72}
    widths={[...new Set([480, 800, 1200, src.width])].filter((w) => w <= src.width)}
    sizes={sizes ?? "(min-width: 1024px) 50vw, 100vw"}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    {...rest}
  />
)}
