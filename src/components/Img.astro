---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  priority?: boolean;
  sizes?: string;
  [key: `data-${string}`]: string | undefined;
}

const { src, alt, class: className, priority, sizes, ...rest } = Astro.props;
const maxWidth = Math.min(src.width, 1600);
const widths = [...new Set([480, 800, 1200, maxWidth])].filter((w) => w <= maxWidth);
---

<Picture
  src={src}
  alt={alt}
  class={className}
  formats={["avif", "webp"]}
  quality={72}
  widths={widths}
  sizes={sizes ?? "(min-width: 1024px) 50vw, 100vw"}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={priority ? "high" : "auto"}
  {...rest}
/>
