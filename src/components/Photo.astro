---
import Img from "@/components/Img.astro";
import type { Photo } from "@/lib/sanity";

interface Props {
  photo: Photo;
  class?: string;
  sizes?: string;
  priority?: boolean;
}

const { photo, class: className, sizes, priority } = Astro.props;
---

{photo.kind === "local" ? (
  <Img src={photo.src} alt={photo.alt} class={className} sizes={sizes} priority={priority} />
) : (
  <img
    src={photo.src}
    srcset={photo.srcset}
    sizes={sizes ?? "(min-width: 1024px) 50vw, 100vw"}
    width={photo.width}
    height={photo.height}
    alt={photo.alt}
    class={className}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
  />
)}
