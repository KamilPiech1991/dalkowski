---
import { ChevronDown, Menu, Phone, X } from "@lucide/astro";
import { NAV, PHONES } from "@/data/site";
import Logo from "@/components/Logo.astro";
import { link } from "@/lib/url";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === link("/") : path.startsWith(link(href));
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/85 backdrop-blur-md">
  <div class="container-page flex h-24 items-center justify-between gap-6">
    <a href={link("/")} class="flex items-center gap-3" aria-label="Dalkowski — strona główna">
      <Logo class="h-14 lg:h-16 w-auto" height={64} priority />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Główna nawigacja">
      {NAV.map((item) =>
        item.children ? (
          <div class="group relative">
            <a
              href={link(item.href)}
              class:list={[
                "inline-flex items-center gap-1 px-4 py-2 text-sm font-medium hover:text-primary transition-colors",
                isActive(item.href) ? "text-primary" : "text-foreground/80",
              ]}
              aria-haspopup="true"
            >
              {item.label}
              <ChevronDown class="h-4 w-4" />
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all absolute left-0 top-full pt-2 min-w-72">
              <div class="rounded-xl border border-border bg-popover shadow-soft p-2">
                {item.children.map((c) => (
                  <a
                    href={link(c.href)}
                    class:list={[
                      "block rounded-lg px-3 py-2.5 text-sm hover:bg-primary-soft hover:text-primary transition-colors",
                      isActive(c.href) ? "bg-primary-soft text-primary" : "text-foreground/80",
                    ]}
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link(item.href)}
            class:list={[
              "px-4 py-2 text-sm font-medium hover:text-primary transition-colors",
              isActive(item.href) ? "text-primary" : "text-foreground/80",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a
        href={PHONES.office.href}
        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
      >
        <Phone class="h-4 w-4" />
        {PHONES.office.label}
      </a>
    </div>

    <!-- Menu mobilne bez JS: natywny <details> -->
    <details class="lg:hidden group/menu">
      <summary
        class="list-none cursor-pointer p-2 text-foreground [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <Menu class="h-6 w-6 group-open/menu:hidden" />
        <X class="h-6 w-6 hidden group-open/menu:block" />
      </summary>
      <div class="absolute inset-x-0 top-full border-t border-border bg-background shadow-soft">
        <div class="container-page py-4 flex flex-col gap-1">
          {NAV.map((item) =>
            item.children ? (
              <details class="group/sub">
                <summary class="w-full flex items-center justify-between px-3 py-3 text-base font-medium text-foreground/90 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  {item.label}
                  <ChevronDown class="h-4 w-4 transition-transform group-open/sub:rotate-180" />
                </summary>
                <div class="pl-4 flex flex-col">
                  <a
                    href={link(item.href)}
                    class="px-3 py-2 text-sm text-foreground/70 hover:text-primary"
                  >
                    Usługi — przegląd
                  </a>
                  {item.children.map((c) => (
                    <a
                      href={link(c.href)}
                      class="px-3 py-2 text-sm text-foreground/70 hover:text-primary"
                    >
                      {c.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={link(item.href)}
                class="px-3 py-3 text-base font-medium text-foreground/90 hover:text-primary"
              >
                {item.label}
              </a>
            ),
          )}
          <a
            href={PHONES.office.href}
            class="mt-3 inline-flex items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground"
          >
            <Phone class="h-4 w-4" />
            {PHONES.office.label}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
